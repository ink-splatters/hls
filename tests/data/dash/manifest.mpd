<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011">
  <Period duration="PT5S">
    <AdaptationSet>
      <Representation id="video">
        <SegmentTemplate duration="2" initialization="init.mp4" media="chunk-$Number$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
