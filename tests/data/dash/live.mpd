<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="dynamic"
     availabilityStartTime="2026-01-01T00:00:00Z" timeShiftBufferDepth="PT4S">
  <Period start="PT0S">
    <AdaptationSet>
      <Representation id="video">
        <SegmentTemplate duration="2" initialization="init.mp4" media="chunk-$Number$.m4s"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
